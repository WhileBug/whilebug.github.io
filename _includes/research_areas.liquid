<div class="research-areas">
  <div class="row row-cols-1 row-cols-md-3 g-3">
    {% for area in site.data.research_areas %}
      <div class="col">
        <a href="{{ '/research/' | relative_url }}#{{ area.anchor }}" aria-label="{{ area.name }}">
          <div class="card h-100 hoverable">
            {% assign img_path = area.image | prepend: 'assets/img/' %}
            {%
              include figure.liquid
              loading="eager"
              path=img_path
              sizes="250px"
              alt=area.name
              class="card-img-top"
            %}
            <div class="card-body">
              <h2 class="card-title">{{ area.name }}</h2>
            </div>
          </div>
        </a>
      </div>
    {% endfor %}
  </div>
</div>
